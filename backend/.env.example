# ERProjects Backend - Variables d'environnement
# Copie ce fichier en .env et modifie les valeurs

# Port du serveur backend
PORT=3001

# Environnement: development | production
NODE_ENV=development

# PostgreSQL - URL de connexion
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://erProjects:erProjects_password@localhost:5432/erProjects

# Secret de session (min 16 caractères, génère une chaîne aléatoire en prod)
SESSION_SECRET=change-this-secret-min-16-chars

# Durée de vie de la session en ms (défaut: 24h)
SESSION_MAX_AGE=86400000

# Répertoire d'upload des pièces jointes
UPLOAD_DIR=./uploads

# Taille max d'un fichier uploadé (en octets, défaut: 50 Mo)
MAX_UPLOAD_SIZE=52428800

# Répertoire des backups
BACKUP_DIR=./backups

# Heure du backup quotidien (0-23)
BACKUP_HOUR=3

# Credentials du premier admin (seed)
ADMIN_EMAIL=admin@erProjects.local
ADMIN_PASSWORD=admin123456

# HTTPS local (voir scripts/setup-https.sh avec mkcert)
HTTPS=false
SSL_KEY_PATH=
SSL_CERT_PATH=
