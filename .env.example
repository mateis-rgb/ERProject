# Variables d'environnement pour docker-compose.yml
# Copie ce fichier en .env :  cp .env.example .env

# Mot de passe PostgreSQL (change-le !)
DB_PASSWORD=erProjects_password

# Secret de session (min 16 caractères, aléatoire recommandé)
SESSION_SECRET=change-this-secret-min-16-chars

# Premier compte admin (créé au démarrage si aucun user)
ADMIN_EMAIL=admin@erProjects.local
ADMIN_PASSWORD=admin123456
